# tenant-web — ortam değişkenleri (.env.local olarak kopyalayıp doldurun)

# Backend API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# WebSocket (canlı teklif)
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Keycloak (OIDC)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=belediyesinden
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=tenant-web

# Yerel geliştirmede subdomain yoksa varsayılan tenant
NEXT_PUBLIC_TENANT_SLUG=talas
