# portal — ortam değişkenleri (.env.local olarak kopyalayıp doldurun)

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Tenant alt-alan temel domaini (ilan detayından tenant portalına yönlendirme,
# ve giriş sonrası tenant admin/süper admin yönlendirmesi)
NEXT_PUBLIC_TENANT_BASE_DOMAIN=belediyesinden.com

# Keycloak (OIDC) — portal kendi public client'ı ('portal') ile giriş yapar
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=belediyesinden
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=portal

# Portal'ın kendi adresi (çıkış sonrası dönülecek yer)
NEXT_PUBLIC_PORTAL_URL=https://belediyesinden.com
