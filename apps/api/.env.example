# Belediyesinden API · yerel geliştirme ortam değişkenleri
# Kullanım: cp apps/api/.env.example apps/api/.env
# (apps/api/.env .gitignore'da — commit edilmez)

# Keycloak (api — token doğrulama)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=belediyesinden
KEYCLOAK_API_CLIENT_ID=api
KEYCLOAK_API_SECRET=

# Keycloak admin (provisioning — scripts/create-tenant.ts)
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8080
KEYCLOAK_ADMIN_TARGET_REALM=belediyesinden
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_TEST_USER_PASSWORD=Test1234!

# Tenant subdomain taban alanı
TENANT_BASE_DOMAIN=belediyesinden.com

# PostgreSQL (docker-compose ile eşleşmeli)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=belediyesinden
POSTGRES_PASSWORD=belediyesinden_dev
POSTGRES_DB=belediyesinden
DB_LOGGING=false
