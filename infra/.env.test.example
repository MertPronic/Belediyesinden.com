# Belediyesinden · Test sunucusu (megi@192.168.1.158, VPN arkası)
# Kullanım: sunucuda `cp .env.test.example .env` (infra/ dizininde) → CHANGE_ME'leri
# güçlü, rastgele değerlerle doldurun (örn. `openssl rand -hex 16`). Gerçek .env
# repoya GİRMEZ.
#
# Adresler nip.io ile çözülür (`<x>.192.168.1.158.nip.io` → 192.168.1.158) — gerçek
# DNS (*.test.belediyesinden.com) gelince TEST_HOST'u ve aşağıdaki URL'leri değiştirip
# frontend'leri yeniden build etmek yeterli (NEXT_PUBLIC_* build anında gömülür).

# === PostgreSQL ===
POSTGRES_USER=belediyesinden
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=belediyesinden

# === Keycloak ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Token ISS — tarayıcının eriştiği adresle birebir aynı olmalı.
KEYCLOAK_HOSTNAME=http://192.168.1.158.nip.io:8080
KEYCLOAK_PUBLIC_URL=http://192.168.1.158.nip.io:8080

# === MinIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# === OpenSearch ===
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME

# === Tenant / adresler ===
TENANT_BASE_DOMAIN=192.168.1.158.nip.io
TENANT_WEB_REDIRECT_TEMPLATE=http://{slug}.192.168.1.158.nip.io:4200/*
TENANT_PROTOCOL=http
DEFAULT_TENANT_SLUG=talas

TENANT_WEB_API_URL=http://192.168.1.158.nip.io:3000/api
TENANT_WEB_WS_URL=ws://192.168.1.158.nip.io:3000/ws
PORTAL_API_URL=http://192.168.1.158.nip.io:3000/api
PORTAL_TENANT_BASE_DOMAIN=192.168.1.158.nip.io:4200
PORTAL_PUBLIC_URL=http://192.168.1.158.nip.io:4201
