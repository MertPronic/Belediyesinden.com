# Belediyesinden · Test sunucusu (megi@192.168.1.158, VPN arkası)
# Kullanım: sunucuda `cp .env.test.example .env` (infra/ dizininde) → CHANGE_ME'leri
# güçlü, rastgele değerlerle doldurun (örn. `openssl rand -hex 16`). Gerçek .env
# repoya GİRMEZ.
#
# Adresler nip.io ile çözülür (`<x>.192.168.1.158.nip.io` → 192.168.1.158), önlerinde
# Caddy (HTTPS, yerel CA — infra/caddy/Caddyfile.test). Gerçek DNS
# (*.test.belediyesinden.com) gelince 192.168.1.158.nip.io geçen her yeri değiştirip
# frontend'leri yeniden build etmek yeterli (NEXT_PUBLIC_* build anında gömülür).

# Test eki (Caddy + proxy ayarları) her compose komutunda otomatik okunsun.
COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml


# === PostgreSQL ===
POSTGRES_USER=belediyesinden
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=belediyesinden

# === Keycloak ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# Token ISS — tarayıcının eriştiği adresle birebir aynı olmalı.
KEYCLOAK_HOSTNAME=https://auth.192.168.1.158.nip.io
KEYCLOAK_PUBLIC_URL=https://auth.192.168.1.158.nip.io

# === MinIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

# === OpenSearch ===
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME

# === Tenant / adresler ===
TENANT_BASE_DOMAIN=192.168.1.158.nip.io
TENANT_WEB_REDIRECT_TEMPLATE=https://{slug}.192.168.1.158.nip.io/*
TENANT_PROTOCOL=https
DEFAULT_TENANT_SLUG=talas

# API portal adresinin altında (/api, /ws) — bkz. Caddyfile.test.
TENANT_WEB_API_URL=https://192.168.1.158.nip.io/api
TENANT_WEB_WS_URL=wss://192.168.1.158.nip.io/ws
PORTAL_API_URL=https://192.168.1.158.nip.io/api
PORTAL_TENANT_BASE_DOMAIN=192.168.1.158.nip.io
PORTAL_PUBLIC_URL=https://192.168.1.158.nip.io
