{
  "annotations": { "list": [] },
  "title": "Belediyesinden API Overview",
  "uid": "bldys-api",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["belediyesinden", "api"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/s)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 2,
      "title": "Request Duration (p95, s)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }]
    },
    {
      "id": 3,
      "title": "Requests by Status Code",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (status)", "legendFormat": "{{status}}" }]
    },
    {
      "id": 4,
      "title": "Requests by Route (top 10)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [{ "expr": "topk(10, sum(rate(http_requests_total[1m])) by (route))", "legendFormat": "{{route}}" }]
    },
    {
      "id": 5,
      "title": "Node.js Event Loop Lag (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [{ "expr": "rate(nodejs_eventloop_lag_seconds_sum[5m])", "legendFormat": "lag" }]
    },
    {
      "id": 6,
      "title": "Process Memory (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [{ "expr": "nodejs_heap_size_used_bytes", "legendFormat": "heap used" }]
    }
  ]
}
