{
  "realm": "belediyesinden",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "clients": [
    {
      "clientId": "portal",
      "name": "Merkezi İlan Portalı",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4201",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:4201/*",
        "http://127.0.0.1:4201/*"
      ],
      "webOrigins": [
        "http://localhost:4201",
        "http://127.0.0.1:4201",
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "tenant-web",
      "name": "Belediye (Tenant) Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://127.0.0.1:4200",
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "api",
      "name": "Backend API (kaynak sunucu)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "SUPERADMIN",
        "description": "Platform süper yöneticisi"
      },
      {
        "name": "TENANT_ADMIN",
        "description": "Belediye yöneticisi"
      },
      {
        "name": "ENCUMEN",
        "description": "Belediye encümen üyesi"
      },
      {
        "name": "VATANDAS",
        "description": "Vatandaş"
      },
      {
        "name": "YATIRIMCI",
        "description": "Yatırımcı / tüzel kişi"
      }
    ]
  },
  "loginTheme": "belediyesinden"
}