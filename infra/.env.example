# Belediyesinden · Yerel geliştirme ortamı
# Kullanım:  cp .env.example .env  (infra/ dizininde) — değerleri kendinize göre değiştirin.
# docker-compose.yml içindeki ${VAR:-default} ifadeleri .env yoksa varsayılanlarla çalışır.

# === PostgreSQL ===
POSTGRES_USER=belediyesinden
POSTGRES_PASSWORD=belediyesinden_dev
POSTGRES_DB=belediyesinden
POSTGRES_PORT=5432

# === Keycloak ===
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# === MinIO (S3 uyumlu nesne depolama) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# === OpenSearch (ilan arama/filtreleme) ===
OPENSEARCH_PORT=9200
OPENSEARCH_ADMIN_PASSWORD=mavi-kartal-siyah-Kalem7!

# === Redis ===
REDIS_PORT=6379
